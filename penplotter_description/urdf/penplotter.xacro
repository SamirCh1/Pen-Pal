<?xml version="1.0" ?>
<robot name="penplotter" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find penplotter_description)/urdf/materials.xacro" />
<xacro:include filename="$(find penplotter_description)/urdf/penplotter.trans" />
<xacro:include filename="$(find penplotter_description)/urdf/penplotter.gazebo" />
<link name="world"/>

<link name="base_link">
  <inertial>
    <origin xyz="9.67684416270395e-15 0.007777777777777779 -2.680566250056496e-17" rpy="0 0 0"/>
    <mass value="2.6634422517134255"/>
    <inertia ixx="0.0065" iyy="0.012355" izz="0.0065" ixy="0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://penplotter_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="grey"><color rgba="0.7 0.7 0.7 1"/></material>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://penplotter_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="cam2_1">
  <inertial>
    <origin xyz="-6.8119533237204e-18 0.01499999999999999 -0.007599348010442601" rpy="0 0 0"/>
    <mass value="0.3408845069920397"/>
    <inertia ixx="9.5e-05" iyy="0.000118" izz="7.7e-05" ixy="-0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.01 -0.0" rpy="0 0 0"/>
