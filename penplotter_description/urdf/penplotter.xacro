      <mesh filename="package://penplotter_description/meshes/link2_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="link3_1">
  <inertial>
    <origin xyz="0.030000000000000027 -0.009797501585496485 -0.11672123652329969" rpy="0 0 0"/>
    <mass value="0.30446537558267023"/>
    <inertia ixx="0.000944" iyy="0.000951" izz="1.3e-05" ixy="0.0" iyz="5e-06" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.03 -0.035 -0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://penplotter_description/meshes/link3_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="grey"><color rgba="0.7 0.7 0.7 1"/></material>
  </visual>
  <collision>
    <origin xyz="0.03 -0.035 -0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://penplotter_description/meshes/link3_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="world_to_base" type="fixed">
  <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
  <parent link="world"/>
  <child link="base_link"/>
</joint>

<joint name="Revolute 9" type="continuous">
  <origin xyz="0.0 0.01 0.0" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="cam2_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="Revolute 10" type="continuous">
  <origin xyz="0.0 0.05 0.0" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="cam_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="Revolute 15" type="continuous">
  <origin xyz="0.05 0.0 -0.0" rpy="0 0 0"/>
  <parent link="cam_1"/>
  <child link="link1_1"/>
  <axis xyz="-0.0 1.0 -0.0"/>
</joint>

<joint name="Revolute 18" type="continuous">
  <origin xyz="0.0 0.0 -0.2" rpy="0 0 0"/>
  <parent link="link1_1"/>
  <child link="link2_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
</joint>

<joint name="Rigid 20" type="fixed">
  <origin xyz="-0.03 0.025 0.0" rpy="0 0 0"/>
  <parent link="cam2_1"/>
  <child link="link3_1"/>
</joint>

</robot>
