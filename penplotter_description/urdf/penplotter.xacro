    <material name="grey"><color rgba="0.7 0.7 0.7 1"/></material>
  </visual>
  <collision>
    <origin xyz="-0.0 -0.05 -0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://penplotter_description/meshes/cam_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="link1_1">
  <inertial>
    <origin xyz="-5.551115123125783e-17 0.014655306368681717 -0.09999999999996399" rpy="0 0 0"/>
    <mass value="0.3577307511653404"/>
    <inertia ixx="0.001521" iyy="0.001528" izz="1.6e-05" ixy="0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.05 -0.05 0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://penplotter_description/meshes/link1_1.stl" scale="0.001 0.001 0.001"/>
