  </collision>
</link>

<link name="link2_1">
  <inertial>
    <origin xyz="-0.14309163168799854 -0.010000000000000023 0.0" rpy="0 0 0"/>
    <mass value="0.917338497669319"/>
    <inertia ixx="6.2e-05" iyy="0.006746" izz="0.006745" ixy="-0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.05 -0.05 0.2" rpy="0 0 0"/>
    <geometry>
