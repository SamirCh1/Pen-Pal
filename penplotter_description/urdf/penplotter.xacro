  </visual>
  <collision>
    <origin xyz="-0.0 -0.01 -0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://penplotter_description/meshes/cam2_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="cam_1">
  <inertial>
    <origin xyz="0.006968421074246578 -0.0050000000000000044 -1.230615331429694e-13" rpy="0 0 0"/>
    <mass value="0.23574476364591623"/>
    <inertia ixx="5.3e-05" iyy="0.000162" izz="0.000113" ixy="-0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.05 -0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://penplotter_description/meshes/cam_1.stl" scale="0.001 0.001 0.001"/>
