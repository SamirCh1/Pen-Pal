<?xml version ="1.0"?>
<robot name="pen_plotter">
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
            <geometry><mesh filename="meshes/base2.stl" scale="0.001 0.001 0.001"/></geometry>
            <material name="grey"><color rgba="0.7 0.7 0.7 1"/></material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
            <geometry><box size="0.20 0.06 0.02"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.5"/>
            <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
